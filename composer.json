{
    "name": "preprio/opsgenie",
    "description": "Laravel integration for Opsgenie alerts, incidents, and heartbeats.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.12.1 || ^8.0.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "authors": [
        {
            "name": "Davy de Vries",
            "email": "me@davy.dev",
            "homepage": "https://davy.dev",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Prepr\\OpsGenie\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prepr\\OpsGenie\\OpsGenieServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
